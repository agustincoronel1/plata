# Configuración de la aplicación
APP_NAME=Plata API
APP_VERSION=0.1.0
ENVIRONMENT=development

# Frontend habilitado en CORS. Es el origen principal.
FRONTEND_URL=http://localhost:5173

# Orígenes extra habilitados en CORS, separados por comas. Normalmente vacío.
#
# En desarrollo (ENVIRONMENT=development) NO hace falta tocarlo: ya se habilitan solos
# http://localhost y http://127.0.0.1 en los puertos 5173, 5174 y 5175, porque para el
# navegador localhost y 127.0.0.1 son orígenes distintos y Vite salta de puerto cuando el
# 5173 está ocupado.
#
# Usalo en producción o para un preview desplegado. Nunca "*": la lista es cerrada.
CORS_EXTRA_ORIGINS=

# PostgreSQL: las lee el contenedor db de compose.yaml
POSTGRES_DB=plata
POSTGRES_USER=plata
POSTGRES_PASSWORD=change_me

# Conexión que usa el backend. Debe coincidir con las tres variables de arriba.
# 127.0.0.1 y no localhost: en Windows localhost resuelve primero a ::1 y, con la base
# caída, cada intento agota el timeout por separado.
DATABASE_URL=postgresql+psycopg://plata:change_me@127.0.0.1:5432/plata

# --- Autenticación (Supabase Auth) ---
# El backend NO emite tokens: solo verifica los que emite Supabase. Para eso alcanza con
# datos públicos del proyecto. Acá NO va la publishable key (no es un secreto de firma y
# no se usa) ni, bajo ningún concepto, la service_role key.
#
# Los valores salen de Supabase > Project Settings > API. Sustituí "tu-proyecto".
SUPABASE_URL=https://tu-proyecto.supabase.co

# JWKS público: de ahí sale la clave con la que se verifica la firma de cada token.
SUPABASE_JWKS_URL=https://tu-proyecto.supabase.co/auth/v1/.well-known/jwks.json

# Emisor esperado (claim `iss` del token).
SUPABASE_JWT_ISSUER=https://tu-proyecto.supabase.co/auth/v1

# Audiencia esperada (claim `aud`). En Supabase es "authenticated".
SUPABASE_JWT_AUDIENCE=authenticated

# Cuánto se cachea el JWKS, en segundos. Ante una clave desconocida (rotación) se
# refresca antes de este plazo, así que no hace falta reiniciar el backend.
SUPABASE_JWKS_CACHE_SECONDS=600

# --- IA ---
# Proveedor de IA: "mock" (por defecto) o "openai".
# Con "mock", Plata funciona sin API key: ideal para desarrollo, tests y demo.
AI_PROVIDER=mock
AI_MODEL=mock-transaction-parser-v1

# Clave del proveedor real. Dejar VACÍA con AI_PROVIDER=mock.
# Nunca se versiona (backend/.env está ignorado) ni aparece en logs o respuestas.
AI_API_KEY=

# Tiempo máximo por llamada al modelo y reintentos ante fallos transitorios.
AI_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=1

# Trazabilidad: por defecto NO se loguea el contenido (texto del usuario, montos,
# descripciones). Dejar en false salvo depuración local explícita.
AI_LOG_CONTENT=false

# Vida de un borrador temporal antes de expirar (segundos). 900 = 15 minutos.
AI_DRAFT_TTL_SECONDS=900

# Store de borradores: "postgres" (persistente, ejecución normal) o "memory" (dev sin base).
AI_DRAFT_STORE=postgres

# Checkpoints de LangGraph: "postgres" en ejecución normal, "memory" para tests/dev explícito.
AI_CHECKPOINT_STORE=postgres
AI_AGENT_MAX_ITERATIONS=5
AI_RAG_VECTOR_MAX_DISTANCE=0.75
AI_RAG_MAX_EVIDENCE=5

# Embeddings del RAG. "mock" = determinístico y sin coste. "openai" usa AI_API_KEY.
AI_EMBEDDING_PROVIDER=mock
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSION=1536

# --- Límites diarios de uso de IA ---
# Protección de costos de la demo pública, por cuenta autenticada. Se cuentan solo las
# operaciones que llegan a invocar al proveedor: un 422, un 409 o una confirmación de
# borrador no gastan cuota. Al agotarla, la API responde 429.
AI_DAILY_CHAT_LIMIT=20
AI_DAILY_PARSE_LIMIT=10

# Desde cuántos usos restantes la interfaz avisa que se está por quedar sin cuota.
AI_USAGE_WARNING_THRESHOLD=3

# Zona horaria del corte diario: el contador se reinicia a las 00:00 locales, no UTC.
AI_USAGE_TIMEZONE=America/Argentina/Buenos_Aires

# --- Validación con proveedor real ---
# Solo para app/scripts/real_ai_smoke.py, el único punto que gasta llamadas pagas.
# Sin RUN_REAL_AI_TESTS=1 el script no hace NINGUNA llamada. No lo dejes activado.
RUN_REAL_AI_TESTS=0
# Techo duro de llamadas reales por corrida (chat + embeddings). El script corta antes.
# Cuenta requests reales, sin reintentos automáticos: una llamada contada = una facturada.
REAL_AI_MAX_CALLS=12
# Timeout bajo a propósito. Cero reintentos, para que el contador no se quede corto.
REAL_AI_TIMEOUT_SECONDS=20
REAL_AI_MAX_RETRIES=0

# URL del backend FastAPI. Si falta, el frontend usa este mismo valor por defecto.
VITE_API_URL=http://127.0.0.1:8000

# --- Supabase Auth ---
# Copiá este archivo a frontend/.env.local y completá con los valores de TU proyecto
# (Supabase > Project Settings > API). frontend/.env.local está ignorado por Git.
#
# Acá solo van valores públicos, pensados para vivir en el navegador:
#   - La URL del proyecto.
#   - La publishable key (la que antes se llamaba "anon key").
#
# NUNCA pongas la secret key ni la service_role key en el frontend: terminarían dentro del
# bundle que se descarga cualquier visitante. Sin estas dos variables, la aplicación falla
# al arrancar con un mensaje que dice exactamente qué falta.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=tu-publishable-key
